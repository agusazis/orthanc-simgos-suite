# ==============================================================================
# ORTHANC PACS & SIMGOS INTEGRATION SUITE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan dengan lingkungan server Anda:
# cp .env.example .env && chmod 600 .env

# --- IDENTITAS RUMAH SAKIT ---
INSTITUTION_NAME="RS Contoh Sejahtera"
# Prefix UID DICOM (Format standar Kemenkes: 1.2.360.[KODE_RS_KEMENKES])
DICOM_UID_ROOT="1.2.360.9999999"

# --- DATABASE POSTGRESQL (Metadata PACS) ---
POSTGRES_DB=orthanc_db
POSTGRES_USER=orthanc_user
POSTGRES_PASSWORD=rahasia_db_pacs_123

# --- CORE PACS (ORTHANC) ---
ORTHANC_SERVER_NAME="RS_CONTOH_PACS"
ORTHANC_AET=ORTHANC
ORTHANC_DICOM_PORT=4242
ORTHANC_HTTP_PORT=8042

# Akun Akses Web / REST API Orthanc
ORTHANC_SIMRS_USER=orthanc_simrs
ORTHANC_SIMRS_PASSWORD=rahasia_orthanc_123

# Modalitas DICOM Terdaftar (JSON String Format)
# Format: {"AET_MODALITAS":["AET_MODALITAS","IP_MODALITAS",PORT]}
ORTHANC_DICOM_MODALITIES={"ROUTER_SS":["ROUTER_SS","192.168.10.50",11112],"CR_ROOM1":["CR_ROOM1","192.168.10.101",104],"CT_SCAN":["CT_SCAN","192.168.10.102",104]}

# --- NGINX REVERSE PROXY (Port 80) ---
NGINX_PORT=80
# Nilai Authorization Basic Auth untuk viewer SIMGOS
# Dihasilkan dari: echo -n 'user:password' | base64
# Contoh: echo -n 'orthanc_simrs:rahasia_orthanc_123' | base64
ORTHANC_BASIC_AUTH="Basic b3J0aGFuY19zaW1yczpyYWhhc2lhX29ydGhhbmNfMTIz"

# --- HL7 MLLP LISTENER (Microservice Python) ---
HL7_PORT=2575
WRITE_DELAY_SEC=0.2

# --- STORAGE PATHS (Mount Host VM / Server) ---
# Path penyimpanan metadata PostgreSQL di SSD lokal VM (cepat)
HOST_PG_DATA_DIR=/var/lib/pacs-local/pg-data
# Path penyimpanan worklist DICOM di SSD lokal VM
HOST_WORKLIST_DIR=/var/lib/pacs-local/worklists
# Path penyimpanan file citra DICOM fisik (NFS NAS Storage / ZFS / Large Volume)
HOST_ORTHANC_STORAGE_DIR=/mnt/pacs-data/orthanc-storage

# --- DICOM MOVER (Sinkronisasi ke Router SatuSehat Kemenkes) ---
# Database SIMGOS (Tabel service_request & layanan.tindakan_medis)
DB_HOST=192.168.10.20
DB_PORT=3306
DB_NAME=kemkes-ihs
DB_USER=dicommover
DB_PASS=rahasia_db_simgos_123

SRC_AE=ORTHANC
SRC_HOST=192.168.10.30
SRC_PORT=4242
DEST_AE=ROUTER_SS

START_DATE="2026-01-01 00:00:00"
QUERY_LIMIT=10
SLEEP_BETWEEN=5
